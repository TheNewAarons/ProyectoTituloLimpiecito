DATABASE_NAME=aseolimp_minda_oficial09
DATABASE_SERVER=localhost
DATABASE_USER=root
DATABASE_USER_PASSWORD=
PORT=3000
PREFIJO=/web-limpiecito

# --- RNF-SEC-01 (ver Docs/variables-de-entorno.md) ---
# Hoy solo NODE_ENV lo lee el código (middleware de errores). El resto aún está escrito en el código y se migra con autorización.
NODE_ENV=development
# Clave con la que se firman los tokens JWT (generar una distinta por ambiente; nunca reutilizar la de producción).
SECRET_KEY=
# Solo si se adopta services/jwt.js (hoy no se usa en ningún sitio).
JWT_SEED=
# Correo saliente (Nodemailer).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Transbank (Webpay Plus): integration en desarrollo, production solo en el servidor.
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# --- RF-CAJA-01 ---
# true = crea la caja del mes el dia 1 a las 00:05 (America/Santiago), idempotente. Apagado por defecto:
# activar solo tras desplegar el ajuste de obtenerCajaActivaDB (varias cajas abiertas a la vez).
CAJA_APERTURA_AUTOMATICA=false
