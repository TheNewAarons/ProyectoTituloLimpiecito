DATABASE_NAME=aseolimp_minda_oficial09
DATABASE_SERVER=localhost
DATABASE_USER=root
DATABASE_USER_PASSWORD=
PORT=3000
PREFIJO=/web-limpiecito

# --- RNF-SEC-01 (ver Docs/variables-de-entorno.md) ---
# SECRET_KEY y JWT_EXPIRES_IN ya los lee el código (AUT-005); SMTP y Transbank aún están escritos en el código y se migran después.
NODE_ENV=development
# OBLIGATORIA: sin ella el backend no arranca. Clave con la que se firman los tokens JWT (una distinta por ambiente;
# nunca reutilizar la de producción). Generarla en tu terminal (no en un chat) y pegarla aquí:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Duración de las sesiones JWT (usuarios, trabajadores, clientes y app). Spec: 8h.
JWT_EXPIRES_IN=8h
# Correo saliente (Nodemailer).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# RF-BOD-03: datos de la empresa para la plantilla de orden de compra (tienen default en el código si faltan).
EMPRESA_NOMBRE=
EMPRESA_RUT=
# Transbank (Webpay Plus): integration en desarrollo, production solo en el servidor.
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# --- RF-CAJA-01 ---
# true = crea la caja del mes el dia 1 a las 00:05 (America/Santiago), idempotente. Apagado por defecto:
# activar solo tras desplegar el ajuste de obtenerCajaActivaDB (varias cajas abiertas a la vez).
CAJA_APERTURA_AUTOMATICA=false
