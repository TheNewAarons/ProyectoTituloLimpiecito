<!-- RF-BI-05 — Aviso a la EMPRESA de una reserva hecha desde la web (el cliente recibe reserva-cliente.hbs).
     Mismo diseño que los correos al cliente (tablas + estilos en línea, azul #0072b4, verde #00a03a), orientado a la acción:
     qué se reservó, cómo contactar al cliente y dónde aprobarla. Autoescape activo: nunca usar triple llaves. -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{titulo}}</title>
</head>
<body style="margin:0;padding:0;background-color:#eef3f8;font-family:Arial,Helvetica,sans-serif;color:#2f3a45;">
  <span style="display:none;max-height:0;overflow:hidden;">Por aprobar: {{servicio}} el {{fechaTexto}}, {{bloque}} hrs. Cliente {{nombre}}. Reserva N° {{orden}}.</span>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef3f8;">
    <tr>
      <td align="center" style="padding:28px 12px;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #dfe6ee;">

          <tr>
            <td align="center" style="padding:26px 24px 18px 24px;">
              <img src="cid:logo-limpiecito" width="170" alt="Aseo Limpiecito" style="display:block;width:170px;max-width:100%;height:auto;border:0;">
            </td>
          </tr>
          <tr>
            <td style="height:4px;line-height:4px;font-size:0;background-color:#00a03a;">&nbsp;</td>
          </tr>

          <!-- Encabezado: nueva reserva por aprobar -->
          <tr>
            <td align="center" style="background-color:#0072b4;padding:26px 24px 24px 24px;color:#ffffff;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                <tr>
                  <td align="center" valign="middle" width="56" height="56" style="width:56px;height:56px;border-radius:28px;background-color:#f0a020;color:#ffffff;font-size:28px;font-weight:bold;line-height:56px;">&#128276;</td>
                </tr>
              </table>
              <div style="padding-top:14px;font-size:22px;font-weight:bold;color:#ffffff;">Nueva reserva por aprobar</div>
              <div style="padding-top:6px;font-size:14px;color:#d6e9f5;">Llegó desde la web de reservas el {{recibida}}.</div>
              <div style="padding-top:14px;">
                <span style="display:inline-block;padding:6px 14px;border-radius:999px;background-color:#ffffff;color:#0072b4;font-size:13px;font-weight:bold;letter-spacing:0.5px;">RESERVA N° {{orden}} · EN PROCESO</span>
              </div>
            </td>
          </tr>

          <!-- Servicio, día y hora -->
          <tr>
            <td style="padding:26px 24px 6px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #dfe6ee;border-radius:10px;">
                <tr>
                  <td style="padding:16px 18px;border-bottom:1px solid #eef2f6;">
                    <div style="font-size:11px;font-weight:bold;color:#00a03a;text-transform:uppercase;letter-spacing:0.6px;">Servicio</div>
                    <div style="padding-top:4px;font-size:17px;font-weight:bold;color:#2f3a45;">{{servicio}}{{#if cantidad}} · cantidad {{cantidad}}{{/if}}</div>
                  </td>
                </tr>
                <tr>
                  <td style="padding:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td width="60%" valign="top" style="padding:14px 18px;border-right:1px solid #eef2f6;">
                          <div style="font-size:11px;font-weight:bold;color:#7b8794;text-transform:uppercase;letter-spacing:0.6px;">&#128197; Día</div>
                          <div style="padding-top:4px;font-size:15px;color:#2f3a45;">{{fechaTexto}}</div>
                        </td>
                        <td width="40%" valign="top" style="padding:14px 18px;">
                          <div style="font-size:11px;font-weight:bold;color:#7b8794;text-transform:uppercase;letter-spacing:0.6px;">&#128337; Horario</div>
                          <div style="padding-top:4px;font-size:15px;color:#2f3a45;">{{bloque}} hrs</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Cliente y servicio -->
          <tr>
            <td style="padding:14px 24px 6px 24px;">
              <div style="font-size:15px;font-weight:bold;color:#2f3a45;padding-bottom:6px;">Cliente</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:14px;line-height:20px;">
                <tr>
                  <td style="padding:7px 0;color:#7b8794;width:35%;">Nombre</td>
                  <td style="padding:7px 0;color:#2f3a45;text-align:right;">{{nombre}}</td>
                </tr>
                <tr>
                  <td style="padding:7px 0;color:#7b8794;border-top:1px solid #eef2f6;">Correo</td>
                  <td style="padding:7px 0;color:#0072b4;text-align:right;border-top:1px solid #eef2f6;">{{correo}}</td>
                </tr>
                <tr>
                  <td style="padding:7px 0;color:#7b8794;border-top:1px solid #eef2f6;">Celular</td>
                  <td style="padding:7px 0;color:#2f3a45;text-align:right;border-top:1px solid #eef2f6;">{{celular}}</td>
                </tr>
                <tr>
                  <td style="padding:7px 0;color:#7b8794;border-top:1px solid #eef2f6;">Dirección</td>
                  <td style="padding:7px 0;color:#2f3a45;text-align:right;border-top:1px solid #eef2f6;">{{direccion}}</td>
                </tr>
                <tr>
                  <td style="padding:7px 0;color:#7b8794;border-top:1px solid #eef2f6;">Recibe</td>
                  <td style="padding:7px 0;color:#2f3a45;text-align:right;border-top:1px solid #eef2f6;">{{recibe}}</td>
                </tr>
                {{#if vehiculo}}
                <tr>
                  <td style="padding:7px 0;color:#7b8794;border-top:1px solid #eef2f6;">Vehículo</td>
                  <td style="padding:7px 0;color:#2f3a45;text-align:right;border-top:1px solid #eef2f6;">{{vehiculo}}</td>
                </tr>
                {{/if}}
                <tr>
                  <td style="padding:10px 0;color:#2f3a45;font-weight:bold;border-top:2px solid #dfe6ee;">Total referencial</td>
                  <td style="padding:10px 0;color:#0072b4;font-weight:bold;font-size:17px;text-align:right;border-top:2px solid #dfe6ee;">{{total}}</td>
                </tr>
              </table>
              <div style="font-size:12px;color:#7b8794;">Pago simulado: no hubo cobro en línea.</div>
            </td>
          </tr>

          <!-- Qué hacer -->
          <tr>
            <td style="padding:18px 24px 26px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:13px;line-height:19px;">
                <tr>
                  <td style="padding:12px 14px;background-color:#fff4e5;border-left:3px solid #f0a020;border-radius:4px;">
                    <strong>Pendiente de aprobación.</strong> Apruébala o recházala en el ERP: <strong>Adm Servicios &gt; Reservas &gt; En proceso</strong>,
                    o en <strong>Analytics &gt; Demanda de reservas &gt; Agenda del día</strong>. El cliente recibe un correo con la decisión.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="background-color:#f4f6f8;padding:16px 24px;font-size:11px;line-height:16px;color:#9aa5b1;border-top:1px solid #e3e7eb;">
              Aviso interno del sistema de Aseo Limpiecito. No respondas a este correo.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
